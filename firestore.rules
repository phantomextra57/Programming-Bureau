rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net (default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Reuseable global security helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Entity structure validation helpers
    function isValidUser(user) {
      return user.id is string && user.id.size() <= 128
        && user.name is string && user.name.size() <= 100
        && user.username is string && user.username.size() <= 100
        && user.role in ['student', 'teacher']
        && user.avatarUrl is string && user.avatarUrl.size() <= 500
        && user.bio is string && user.bio.size() <= 1000
        && user.skills is list && user.skills.size() <= 50
        && user.subscribersCount is int
        && user.subscribedTeachers is list && user.subscribedTeachers.size() <= 100;
    }

    function isValidPost(post) {
      return post.id is string && post.id.size() <= 128
        && post.authorId is string && post.authorId.size() <= 128
        && post.authorName is string && post.authorName.size() <= 100
        && post.authorAvatarUrl is string && post.authorAvatarUrl.size() <= 500
        && post.authorRole in ['student', 'teacher']
        && post.content is string && post.content.size() <= 5000
        && post.type in ['general', 'error', 'tutorial']
        && post.likes is list && post.likes.size() <= 10000
        && post.comments is list && post.comments.size() <= 2000
        && post.createdAt is string && post.createdAt.size() <= 50;
    }

    function isValidTeacherChannelPost(channelPost) {
      return channelPost.id is string && channelPost.id.size() <= 128
        && channelPost.teacherId is string && channelPost.teacherId.size() <= 128
        && channelPost.title is string && channelPost.title.size() <= 200
        && channelPost.content is string && channelPost.content.size() <= 10000
        && channelPost.createdAt is string && channelPost.createdAt.size() <= 50;
    }

    function isValidNotification(notify) {
      return notify.id is string && notify.id.size() <= 128
        && notify.userId is string && notify.userId.size() <= 128
        && notify.senderName is string && notify.senderName.size() <= 100
        && notify.senderAvatarUrl is string && notify.senderAvatarUrl.size() <= 500
        && notify.type in ['like', 'comment', 'solution', 'system', 'broadcast', 'ai_completion']
        && notify.title is string && notify.title.size() <= 200
        && notify.message is string && notify.message.size() <= 1000
        && notify.linkTab in ['feed', 'ide', 'teachers', 'profile']
        && notify.read is bool
        && notify.createdAt is string && notify.createdAt.size() <= 50;
    }

    // Collection Security Rules

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data);
    }

    match /posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.authorId && isValidPost(request.resource.data) && isValidId(postId);
      allow update: if isSignedIn() && isValidId(postId) && (
        (request.resource.data.authorId == request.auth.uid && isValidPost(request.resource.data)) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'comments', 'isSolved', 'solvedByCommentId']))
      );
      allow delete: if isSignedIn() && isValidId(postId) && resource.data.authorId == request.auth.uid;
    }

    match /channels_posts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.teacherId == request.auth.uid && isValidTeacherChannelPost(request.resource.data) && isValidId(postId);
      allow update: if isSignedIn() && isValidId(postId) && request.resource.data.teacherId == request.auth.uid && isValidTeacherChannelPost(request.resource.data);
      allow delete: if isSignedIn() && isValidId(postId) && resource.data.teacherId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidNotification(request.resource.data) && isValidId(notificationId);
      allow update: if isSignedIn() && isValidId(notificationId) && request.resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && isValidId(notificationId) && resource.data.userId == request.auth.uid;
    }
  }
}
